{
  "expo": {
    "name": "KisaanAI",
    "slug": "KisaanAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kisaanai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Kisaan AI uses your microphone for live voice conversations about your farm.",
        "ExpoLocalization_supportsRTL": true,
        "CFBundleLocalizations": [
          "en",
          "ur"
        ]
      },
      "bundleIdentifier": "com.haiderdev1.KisaanAI"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.haiderdev1.KisaanAI"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#061510",
          "image": "./assets/images/splash-icon.png"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "ur"
            ],
            "android": [
              "en",
              "ur"
            ]
          },
          "supportsRTL": true
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kisaan AI uses your location to show the weather and farming advice for your area.",
          "locationAlwaysAndWhenInUsePermission": "Kisaan AI uses your location to show the weather and farming advice for your area."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kisaan AI uses your camera to photograph crops for farming guidance.",
          "photosPermission": "Kisaan AI uses your photos so you can share crop images for farming guidance."
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Kisaan AI uses your microphone for live voice conversations about your farm.",
          "iosBackgroundMode": false,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO"
          ],
          "androidForegroundService": false,
          "disableFFmpeg": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "36b6804a-9a43-4370-8310-5e4fe8cd2380"
      }
    },
    "owner": "haidermukhtar"
  }
}
